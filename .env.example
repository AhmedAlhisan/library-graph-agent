# Copy this file to .env and fill in your own values. Never commit .env.

# --- LLM ---------------------------------------------------------------
# Default: free local model through Ollama (OpenAI-compatible endpoint).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# To switch to OpenAI later, replace the three lines above with:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-REPLACE_ME
# LLM_MODEL=gpt-4.1-mini

# --- Neo4j -------------------------------------------------------------
# Password must be at least 8 characters
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
